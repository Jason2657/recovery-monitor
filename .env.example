# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Optional: model / tuning ─────────────────────────────────────────────────
# ANTHROPIC_MODEL=claude-opus-4-8
# RISK_THRESHOLD=0.5            # escalate when normalized risk >= this (0..1 knob)

# ── Optional: voice (Deepgram STT/TTS in the web app) ────────────────────────
DEEPGRAM_API_KEY=your_deepgram_key_here

# ── Optional: Arize / Phoenix observability ──────────────────────────────────
# Tracing is OFF by default (clean no-op). Turn it on one of two ways:
#   1) Local Phoenix:  pip install arize-phoenix && phoenix serve
#                      then set ENABLE_TRACING=1
#   2) Arize cloud:    set ARIZE_API_KEY + ARIZE_SPACE_ID
# ENABLE_TRACING=1
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# ARIZE_API_KEY=your_arize_key_here
# ARIZE_SPACE_ID=your_arize_space_id_here

# ── Optional: Band governance backend ────────────────────────────────────────
# Defaults to the in-process LocalBandRoom. Point at a real Band service once
# access is confirmed (RemoteBandRoom is the adapter seam).
# BAND_BACKEND=local           # or "remote"
# BAND_API_KEY=your_band_key_here

# ── Optional: Browserbase web research (tailored medical literature) ──────────
# Research falls back to the keyless PubMed E-utilities API; these enable the
# full Browserbase browser-automation path (also needs `playwright install`).
BROWSERBASE_API_KEY=your_browserbase_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here
