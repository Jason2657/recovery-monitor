# Copy to .env and fill in. The demo runs WITHOUT any of these (agent logic is
# stubbed and tracing no-ops gracefully) — they are only needed once you wire in
# real LLM calls and remote observability/governance.

# --- Anthropic (Claude) — Skeptic, Reconciler, Self-report NLP LLM calls ---
ANTHROPIC_API_KEY=

# Optional: override the default Claude model used across agents.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Arize / Phoenix observability ---
# Leave blank to use a local Phoenix instance (or skip tracing entirely).
ARIZE_API_KEY=
ARIZE_SPACE_ID=

# --- Band governed-coordination room (placeholder for the real API) ---
BAND_API_KEY=

# --- The single tunable knob the self-correction loop nudges (0.0–1.0) ---
# RISK_THRESHOLD=0.5
